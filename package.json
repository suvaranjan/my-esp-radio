{
  "name": "radio-server",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-channel audio radio server (YouTube + IPTV sources -> MP3) for ESP32 internet radio",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "find-iptv": "node scripts/find-iptv.js",
    "probe": "node scripts/probe-all.js",
    "test": "node --test"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  }
}
